project_name        = "garage-management"
environment          = "development"
region               = "us-east-1"
vpc_cidr             = "10.0.0.0/16"
eks_version          = "1.35"
node_instance_type   = "t3.medium"
node_min_size        = 2
node_desired_size    = 2
node_max_size        = 3
single_nat_gateway   = true
